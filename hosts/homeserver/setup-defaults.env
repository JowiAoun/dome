# Seed values setup.sh uses to pre-select the module checklist for this host.
# All off: the server runs services, and you work on it over SSH. The base
# layer in home.nix is the shell, and that is all it needs. Turn one on in
# user-config.nix if you start using it there.
MODULE_PYTHON=false
MODULE_NODE=false
MODULE_JAVA=false
MODULE_AI=false
MODULE_CLOUD=false
# No screen, so no desktop apps. hosts/homeserver/default.nix forces this off
# even if it gets turned on here.
MODULE_APPS=false
MODULE_TINYPROXY=false
